# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==============================================================================
# Local PostgreSQL Configuration (for self-sustaining local machine execution)
# ==============================================================================
# Host of the PostgreSQL database server (default: 127.0.0.1 or localhost)
SQL_HOST="127.0.0.1"

# Port on which PostgreSQL is listening (default: 5432)
SQL_PORT="5432"

# PostgreSQL database name (create via 'createdb medifaq' or 'CREATE DATABASE medifaq;')
SQL_DB_NAME="medifaq"

# PostgreSQL user credentials for application connections
SQL_USER="postgres"
SQL_PASSWORD="your_postgres_password"

# PostgreSQL user credentials for Drizzle Kit schema migrations (can be same as SQL_USER)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_postgres_password"

# Port for the Express full-stack development server
PORT="3000"

# ==============================================================================
# Outgoing Email & Admin Notification Configuration (Optional)
# ==============================================================================
# Configure SMTP credentials to deliver feedback alerts and announcements to real external inboxes (e.g., Gmail, SendGrid)
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MediFAQ Portal <no-reply@medifaq.my>"

# ==============================================================================
# Security
# ==============================================================================
# Secret used to sign login session tokens. REQUIRED for production (min. 16 characters, e.g. `openssl rand -hex 32`).
# If unset, a temporary random secret is used and everyone is signed out whenever the server restarts.
SESSION_SECRET=""

# Passwords for the demo data created by `npm run db:seed` (the seed only writes hashes, never plaintext).
# Unset: development uses insecure demo defaults; NODE_ENV=production generates random one-time passwords.
ADMIN_SEED_PASSWORD=""
DEMO_SEED_PASSWORD=""

# Tests only: the 'admin' password used by `npm test` (defaults to ADMIN_SEED_PASSWORD, then 'admin')
TEST_ADMIN_PASSWORD=""

# Login throttling (per server process). Failures per IP+username before delays start, and per IP overall.
LOGIN_MAX_ATTEMPTS="5"
LOGIN_MAX_PER_IP="30"

# Set when running behind a reverse proxy/load balancer so the real visitor IP is used
# (e.g. 1 = one proxy hop, "loopback", or a CIDR list). Leave empty when not behind a proxy.
TRUST_PROXY=""

# Production only: who may embed the site in an iframe (CSP frame-ancestors). Default: same origin only.
CSP_FRAME_ANCESTORS=""
